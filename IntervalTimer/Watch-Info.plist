<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 暗号化の申告。標準の HTTPS すら使わないので「該当なし」。
	     無いと、ビルドごとに App Store Connect で輸出規制の質問に答えることになる -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>WKApplication</key>
	<true/>

	<!-- 配信の器になる iOS アプリ。**Xcode は watchOS のアーカイブを
	     App Store へ出せない**（配布方式のクラスが存在しない）ので、
	     iOS アプリの中に入れて出す。 -->
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.zzzjjj080.IntervalTimer</string>

	<!-- **これが肝。** 付けておくと、使う人は iPhone アプリを入れずに
	     Apple Watch だけにインストールできる。単体で使える体験は変わらない。 -->
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<true/>

	<!-- 走っている間、アプリを前面に留めて動かし続けるため。HKWorkoutSession に必要。
	     self-care（WKExtendedRuntimeSession）は宣言しない。上限が10分で練習の長さに足りず、
	     野球のタイマーが使う理由も審査で説明しにくい。ヘルスケアを断った人には、許可を画面で案内する（2026-09-13 決定）。 -->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<!-- 実機にどのビルドが入っているかを設定画面に出すための印（BuildInfo）。
	     インストール用スクリプトが IT_BUILD_STAMP を渡す。Xcode から直接ビルドすると空になる -->
	<key>ITBuildStamp</key>
	<string>$(IT_BUILD_STAMP)</string>
</dict>
</plist>

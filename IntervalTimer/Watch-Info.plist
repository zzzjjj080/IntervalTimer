<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 暗号化の申告。標準の HTTPS すら使わないので「該当なし」。
	     無いと、ビルドごとに App Store Connect で輸出規制の質問に答えることになる -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>WKApplication</key>
	<true/>

	<!-- 配信の器になる iOS アプリ。**Xcode は watchOS のアーカイブを
	     App Store へ出せない**（配布方式のクラスが存在しない）ので、
	     iOS アプリの中に入れて出す。 -->
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.zzzjjj080.IntervalTimer</string>

	<!-- **これが肝。** 付けておくと、使う人は iPhone アプリを入れずに
	     Apple Watch だけにインストールできる。単体で使える体験は変わらない。 -->
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<true/>

	<!-- 走っている間、アプリを前面に留めて動かし続けるため。
	     - workout-processing … HKWorkoutSession 用（本筋。上限なし）
	     - self-care ………………… WKExtendedRuntimeSession 用（予備。上限1時間）

	     **予備の側は、この種別を書かないと start() しても即 invalidate される。**
	     ヘルスケアを断った人は本筋を使えないので、これが無いと
	     1分ほどで文字盤に戻ってしまう（引き継ぎ書 4-112）。 -->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
		<string>self-care</string>
	</array>
</dict>
</plist>
